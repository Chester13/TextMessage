<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ── Conversation ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_conversation" />

        <EditText
            android:id="@+id/et_sender"
            style="@style/Field"
            android:hint="@string/hint_sender"
            android:text="@string/default_sender" />

        <EditText
            android:id="@+id/et_group"
            style="@style/Field"
            android:hint="@string/hint_group" />

        <EditText
            android:id="@+id/et_title"
            style="@style/Field"
            android:hint="@string/hint_title" />

        <EditText
            android:id="@+id/et_message"
            style="@style/Field"
            android:hint="@string/hint_message"
            android:text="@string/default_message" />

        <CheckBox
            android:id="@+id/cb_autonumber"
            style="@style/Toggle"
            android:checked="true"
            android:text="@string/opt_autonumber" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_backdate" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_backdate"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:hint="@string/hint_delay"
                android:inputType="number"
                android:text="@string/default_backdate" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/opt_backdate"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── Avatar sources ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_avatar" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_avatar" />

        <CheckBox
            android:id="@+id/cb_large_icon"
            style="@style/Toggle"
            android:checked="true"
            android:text="@string/opt_large_icon" />

        <CheckBox
            android:id="@+id/cb_person_icon"
            style="@style/Toggle"
            android:checked="false"
            android:text="@string/opt_person_icon" />

        <CheckBox
            android:id="@+id/cb_omit_icon"
            style="@style/Toggle"
            android:checked="false"
            android:text="@string/opt_omit_icon" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_omit_icon" />

        <!-- ── Open-the-app intent ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_intent" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_intent" />

        <CheckBox
            android:id="@+id/cb_content_intent"
            style="@style/Toggle"
            android:checked="true"
            android:text="@string/opt_content_intent" />

        <CheckBox
            android:id="@+id/cb_auto_cancel"
            style="@style/Toggle"
            android:text="@string/opt_auto_cancel" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_auto_cancel" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:text="@string/opt_creator_bal" />

        <Spinner
            android:id="@+id/sp_creator_bal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- ── Notification identity ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_identity" />

        <TextView
            style="@style/Hint"
            android:text="@string/opt_key_shape" />

        <Spinner
            android:id="@+id/sp_key_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_key_shape" />

        <CheckBox
            android:id="@+id/cb_group_summary"
            style="@style/Toggle"
            android:text="@string/opt_group_summary" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_group_summary" />

        <EditText
            android:id="@+id/et_notif_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_notif_group"
            android:inputType="text"
            android:text="MESSAGES" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_notif_group" />

        <!-- ── Direct Reply ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_reply" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_reply" />

        <CheckBox
            android:id="@+id/cb_reply"
            style="@style/Toggle"
            android:checked="true"
            android:text="@string/opt_reply" />

        <CheckBox
            android:id="@+id/cb_cancel_after_reply"
            style="@style/Toggle"
            android:checked="false"
            android:text="@string/opt_cancel_after_reply" />

        <CheckBox
            android:id="@+id/cb_rebuild_after_reply"
            style="@style/Toggle"
            android:text="@string/opt_rebuild_after_reply" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_rebuild" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/et_rebuild_gap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="@string/hint_rebuild_gap"
                android:text="@string/default_rebuild_gap" />

            <Button
                android:id="@+id/btn_rebuild"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_rebuild" />
        </LinearLayout>

        <!-- ── Posting ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_post" />

        <Button
            android:id="@+id/btn_post"
            style="@style/Action"
            android:text="@string/btn_post" />

        <TextView
            style="@style/Hint"
            android:text="@string/help_album" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_album_size"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="@string/default_album_size" />

            <Button
                android:id="@+id/btn_post_album"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_post_album" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="@string/help_repost" />

        <CheckBox
            android:id="@+id/cb_bump_time"
            style="@style/Toggle"
            android:checked="false"
            android:text="@string/opt_bump_time" />

        <Button
            android:id="@+id/btn_repost"
            style="@style/Action"
            android:text="@string/btn_repost" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_delay"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:hint="@string/hint_delay"
                android:inputType="number"
                android:text="@string/default_delay" />

            <Button
                android:id="@+id/btn_repost_delayed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_repost_delayed" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Action"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_reset"
            style="@style/Action"
            android:text="@string/btn_reset" />

        <Button
            android:id="@+id/btn_reset_all"
            style="@style/Action"
            android:text="@string/btn_reset_all" />

        <!-- ── Observed events ── -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_log" />

        <Button
            android:id="@+id/btn_clear_log"
            style="@style/Action"
            android:text="@string/btn_clear_log" />

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
